# SERVER ONLY. Never rename these to VITE_* or paste keys into src/.
# Copy this file to .env, then set values on the server / hosting dashboard.
SUPABASE_URL=https://your-project.supabase.co
# Preferred: sb_secret_... ; legacy service_role is also accepted here.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=session-media

# Public HTTPS origin of THIS Node application (also used in QR links).
# For phone testing use your computer's LAN IP instead of localhost.
APP_PUBLIC_URL=http://localhost:4173
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Operator login / trusted background producer authentication. Not a Supabase key.
TERMINAL_WRITE_TOKEN=

# Must be a persistent disk, shared by the web server and its in-process worker.
# Run ONE application instance per DATA_DIR. Do not use an ephemeral/serverless disk.
DATA_DIR=./.data
UPLOAD_MAX_MB=50
QUEUE_MAX_MB=512
UPLOAD_MAX_ATTEMPTS=5
RETRY_BASE_MS=2000
SIGNED_URL_TTL_SECONDS=3600
# Set to 1 ONLY when behind one trusted reverse proxy.
TRUST_PROXY=0
